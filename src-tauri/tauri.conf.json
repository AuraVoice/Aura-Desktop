{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aura Desktop",
  "version": "0.7.1",
  "identifier": "com.aura.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aura Desktop",
        "width": 560,
        "height": 400,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https://juno-backend-620715294422.us-central1.run.app https://us.i.posthog.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://*.livekit.cloud wss://*.livekit.cloud https://*.sentry.io https://api.openai.com ws://localhost:1420; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": ["resources/dictation/*"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["aura"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGQ0QzMThFNjYzRkVDRUQKUldUdDdEOW1qakhOSDcwS0hKRXFoTSt5Ymt0WTZyaGNVdjRSVG15OUNEMmMvWnE3eWo0QzdEQW8K",
      "endpoints": [
        "https://github.com/AuraVoice/Aura-Desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
